# ForgeLab dashboard environment template. Copy to .env.local next to this file
# (Next.js loads it for dev and build); set the same variable in Netlify's site
# environment for a deployed build.

# Backend API base URL: used by server rendering and the /api/forgelab/* rewrite.
# Read at build time, so redeploy after changing it.
FORGELAB_API_URL=http://127.0.0.1:8090
