# ForgeLab — environment variables (template)
# Copy to `.env` and fill in. Never commit a real `.env`.

# Runtime environment: local | staging | cloud
FORGELAB_ENV=local

# Platform runtime
FORGELAB_PORT=8080
FORGELAB_LOG_LEVEL=info

# Application manifest source
FORGELAB_MANIFEST=./manifests/application.example.yaml

# Backend / simulation core (once implemented)
# DATABASE_URL=postgres://forgelab:forgelab@localhost:5432/forgelab
# REDIS_URL=redis://localhost:6379/0
# KAFKA_BROKERS=localhost:9092

# Dashboard (Next.js)
# DASHBOARD_PORT=3000

# Observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Analytics (Python, optional — later)
# ANALYTICS_PORT=8000