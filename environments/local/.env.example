# Environment template for the local preset. Copy to .env to override
# defaults; never commit real credentials.
#
#   cp environments/local/.env.example environments/local/.env

POSTGRES_USER=forgelab
POSTGRES_PASSWORD=forgelab
POSTGRES_DB=forgelab
POSTGRES_PORT=5432

PROXY_HTTP_PORT=8080

# Observability overlay (compose.observability.yaml)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Messaging overlay (compose.messaging.yaml)
REDIS_PORT=6379
RABBITMQ_USER=forgelab
RABBITMQ_PASSWORD=forgelab
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
KAFKA_PORT=9092
