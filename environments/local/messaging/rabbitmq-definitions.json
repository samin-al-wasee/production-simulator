{
  "rabbit_version": "4",
  "vhosts": [{ "name": "/" }],
  "exchanges": [
    { "name": "work", "vhost": "/", "type": "direct", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "work.dlx", "vhost": "/", "type": "direct", "durable": true, "auto_delete": false, "internal": false, "arguments": {} }
  ],
  "queues": [
    {
      "name": "work.jobs",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum",
        "x-delivery-limit": 3,
        "x-dead-letter-exchange": "work.dlx",
        "x-dead-letter-routing-key": "jobs"
      }
    },
    {
      "name": "work.jobs.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": { "x-queue-type": "quorum" }
    }
  ],
  "bindings": [
    { "source": "work", "vhost": "/", "destination": "work.jobs", "destination_type": "queue", "routing_key": "jobs", "arguments": {} },
    { "source": "work.dlx", "vhost": "/", "destination": "work.jobs.dlq", "destination_type": "queue", "routing_key": "jobs", "arguments": {} }
  ]
}
