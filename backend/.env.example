# ForgeLab backend environment template. Copy to .env and adjust for a run
# outside the devcontainer. Nothing loads .env for you: `forgelab serve` reads
# these from the environment, so export them (the devcontainer sets them
# already) or pass the matching flags.

# Postgres application store (ADR-0030). Embedded migrations apply at startup.
# Unset, the API runs without a store. Inside the devcontainer the compose `db`
# service is the host, so use:
#   postgres://postgres:postgres@db:5432/forgelab?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forgelab?sslmode=disable

# The dashboard's origin, returned in CORS headers when the API serves another
# origin. Unset sends no CORS headers.
FORGELAB_ALLOW_ORIGIN=http://localhost:3001
